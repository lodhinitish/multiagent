# Copy to .env and fill in real values. .env is git-ignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (Azure, Ollama, vLLM, ...)
# OPENAI_BASE_URL=

# Optional API settings
# AGENTS_FILE=agents.json
# TOOLS_FILE=http_tools.json
# TOOL_MODULES=multiagent.builtin_tools
# LOANS_FILE=loans.json

# Optional voice WebSocket settings (speech uses OPENAI_API_KEY)
# STT_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# TTS_INSTRUCTIONS=Speak clearly, warmly and at a calm pace, like a helpful customer service agent.

# Login. The first admin is created from these when users.json has no users yet.
# If ADMIN_PASSWORD is empty, a random password is generated and printed in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# USERS_FILE=users.json
# AUTH_TOKEN_HOURS=12
